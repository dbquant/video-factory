# Copy to .env and fill in. .env is gitignored.

# APIMart: the main provider for video, images and the vision judge (usually the cheapest). https://apimart.ai/keys
APIMART_API_KEY=

# Kie.ai: the second provider (music, voices, file hosting, and any model APIMart doesn't sell or sells for more).
# https://kie.ai/api-key . The engine compares both live prices and sends each job to the cheaper one.
KIE_API_TOKEN=

# ElevenLabs: TTS, speech-to-speech and sound effects. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: review board port (default 4317)
# BOARD_PORT=4317

# Optional local interfaces. BASE_URL includes /v1 for OpenAI-compatible services.
# VF_TEXT_BASE_URL=http://127.0.0.1:8080/v1/
# VF_TEXT_MODEL=your-text-model
# VF_TEXT_API_KEY=
# VF_JUDGE_BASE_URL=http://127.0.0.1:8080/v1/
# VF_JUDGE_MODEL=your-vision-model
# VF_JUDGE_API_KEY=
# VF_TTS_BASE_URL=http://127.0.0.1:8002/v1/
# VF_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# VF_TTS_VOICE=Vivian
# VF_TTS_API_KEY=
# VF_COMFY_BASE_URL=http://127.0.0.1:8188/
# VF_COMFY_API_KEY=
